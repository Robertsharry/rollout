# ----------------------------------------------------------------------------
# Rollout — environment variables
# Copy to .env.local and fill in. Public pages run without these; auth + DB
# features activate once they're set.
# ----------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for SEO canonical/OG + auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord server invite for the "Join" CTA
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET=

# Discord OAuth app (https://discord.com/developers/applications)
# Add redirect URIs: http://localhost:3000/api/auth/callback/discord  (+ prod URL)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Neon Postgres connection string (https://neon.tech or Vercel marketplace)
DATABASE_URL=

# Stripe (https://dashboard.stripe.com/apikeys)
# Use sk_test_/pk_test_ keys locally; live keys are set ONLY in Vercel env vars.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# A Price for the "name your own amount" donation (Stripe: customer chooses price)
STRIPE_DONATION_PRICE_ID=
